[
  {
    "label": "──── 1. 查看 / 浏览 ────",
    "command": "true",
    "args": [],
    "tags": ["git-command"],
    "reveal": "never",
    "hide": "always"
  },
  {
    "label": "Git · 包含此提交的分支  ($ZED_GIT_SHA_SHORT)",
    "command": "git",
    "args": ["--no-pager", "branch", "-a", "--contains", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
    "reveal": "always"
  },
  {
    "label": "Git · 包含此提交的 tag  ($ZED_GIT_SHA_SHORT)",
    "command": "git",
    "args": ["--no-pager", "tag", "--contains", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
    "reveal": "always"
  },
  {
    "label": "Git · 此提交概览 (stat)  ($ZED_GIT_SHA_SHORT)",
    "command": "git",
    "args": ["--no-pager", "show", "--stat", "--pretty=fuller", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
    "reveal": "always"
  },
  {
    "label": "Git · 此提交完整 diff  ($ZED_GIT_SHA_SHORT)",
